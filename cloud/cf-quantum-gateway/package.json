  "description": "RPrime $0/mo Cloudflare Workers Edge Cache, Open-Science Federation & Auto-Failover Quantum Gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
